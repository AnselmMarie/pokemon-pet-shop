{
  "name": "@pokemon-pet-shop/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/app-hosts/api/dist/package.json",
          "{workspaceRoot}/app-hosts/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/app-hosts/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@pokemon-pet-shop/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@pokemon-pet-shop/api:build:development"
          },
          "production": {
            "buildTarget": "@pokemon-pet-shop/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -f app-hosts/api/Dockerfile -t pokemon-api .",
          "cwd": "{workspaceRoot}"
        }
      },
      "docker-run": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker-build"
        ],
        "options": {
          "command": "docker run -p 3333:3333 pokemon-api",
          "cwd": "{workspaceRoot}"
        }
      },
      "docker-deploy-prod": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com",
            "docker build -f app-hosts/api/Dockerfile -t pokemon-api .",
            "docker tag pokemon-api:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/pokemon-api:prod",
            "docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/pokemon-api:prod"
          ],
          "cwd": "{workspaceRoot}",
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@pokemon-pet-shop/types": "workspace:*",
    "@pokemon-pet-shop/util-pricing": "workspace:*",
    "express": "*"
  }
}
