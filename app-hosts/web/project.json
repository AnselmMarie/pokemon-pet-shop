{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "app-hosts/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "clean-static-remotes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf tmp/static-remotes",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "options": {
        "port": 4200,
        "env": {
          "WEBPACK_SERVE": "true",
          "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"CommonJS\",\"moduleResolution\":\"Node10\",\"customConditions\":null}"
        },
        "devRemotes": ["webHomepage", "webHeader", "webFooter"]
      },
      "dependsOn": ["clean-static-remotes", "typecheck"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"]
    }
  }
}
