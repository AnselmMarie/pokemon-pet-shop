{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@pokemon-pet-shop/source"],
    "baseUrl": ".",
    "typeRoots": [
      "./libs/types",
      "./node_modules",
      "./node_modules/@types",
      "./apps"
    ],
    "paths": {
      "@dsTokens": ["libs/ds-tokens/src/index.ts"],
      "@features/*": ["libs/features/*"],
      "@services/*": ["libs/services/*"],
      "@ui/*": ["libs/ui/*"],
      "@utils/*": ["libs/utils/*"],
      "footer/Module": ["remotes/footer/src/remote-entry.ts"],
      "header/Module": ["remotes/header/src/remote-entry.ts"],
      "homepage/Module": ["remotes/homepage/src/remote-entry.ts"],
      "not-found/Module": ["remotes/not-found/src/remote-entry.ts"],
      "side-cart/Module": ["remotes/side-cart/src/remote-entry.ts"],
      "storeCart/Module": ["remotes/storeCart/src/remote-entry.ts"],
      "storeTheme/Module": ["remotes/storeTheme/src/remote-entry.ts"]
    }
  }
}
