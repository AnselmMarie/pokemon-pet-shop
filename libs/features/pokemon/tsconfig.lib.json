{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "pokemon",
      "pokemon/species"
    ],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../services/pokemon-api/tsconfig.lib.json"
    },
    {
      "path": "../../utils/detect/tsconfig.lib.json"
    },
    {
      "path": "../../ui/image/tsconfig.lib.json"
    },
    {
      "path": "../../ui/button/tsconfig.lib.json"
    },
    {
      "path": "../../ui/card/tsconfig.lib.json"
    },
    {
      "path": "../../utils/textTransform/tsconfig.lib.json"
    },
    {
      "path": "../../ui/skeleton/tsconfig.lib.json"
    },
    {
      "path": "../../ui/typography/tsconfig.lib.json"
    },
    {
      "path": "../../ui/iconPokeType/tsconfig.lib.json"
    },
    {
      "path": "../../ui/hideInMobile/tsconfig.lib.json"
    },
    {
      "path": "../../ui/box/tsconfig.lib.json"
    },
    {
      "path": "../../ui/scrollWrapper/tsconfig.lib.json"
    },
    {
      "path": "../../ui/tag/tsconfig.lib.json"
    }
  ]
}
