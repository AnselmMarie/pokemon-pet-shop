{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts"],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "paths": {
      "@pokemon-pet-shop/feature-switch-theme": ["libs/features/switch-theme/src/index.ts"],
      "@pokemon-pet-shop/ui-box": ["libs/ui/box/src/index.ts"],
      "@pokemon-pet-shop/ui-container": ["libs/ui/container/src/index.ts"],
      "@pokemon-pet-shop/ui-icon": ["libs/ui/icon/src/index.ts"],
      "@pokemon-pet-shop/ui-image": ["libs/ui/image/src/index.ts"],
      "@pokemon-pet-shop/ui-hide-in-mobile": ["libs/ui/hide-in-mobile/src/index.ts"],
      "@pokemon-pet-shop/remote-modal-side-cart": ["remotes/modal-side-cart/src/index.ts"],
      "@pokemon-pet-shop/ui-modal": ["libs/ui/modal/src/index.ts"]
    }
  },
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../ui/modal/tsconfig.lib.json"
    },
    {
      "path": "../../../remotes/modal-side-cart/tsconfig.app.json"
    },
    {
      "path": "../../ui/hide-in-mobile/tsconfig.lib.json"
    },
    {
      "path": "../../ui/image/tsconfig.lib.json"
    },
    {
      "path": "../../ui/icon/tsconfig.lib.json"
    },
    {
      "path": "../../ui/container/tsconfig.lib.json"
    },
    {
      "path": "../../ui/box/tsconfig.lib.json"
    },
    {
      "path": "../switch-theme/tsconfig.lib.json"
    }
  ]
}
